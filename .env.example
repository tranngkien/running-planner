# Tài khoản admin duy nhất
ADMIN_USERNAME=admin
# Tạo bằng: node -e "console.log(require('bcryptjs').hashSync('mat-khau', 12))"
# Lưu ý: escape mọi ký tự $ thành \$ (Next diễn giải $ thành biến)
ADMIN_PASSWORD_HASH=
# Chuỗi ngẫu nhiên >= 32 ký tự để ký JWT phiên đăng nhập
SESSION_SECRET=

# Gemini (Google AI Studio)
GEMINI_API_KEY=
# Mặc định gemini-flash-lite-latest (free tier, hạn mức cao hơn); dự phòng GEMINI_FALLBACK_MODEL=gemini-flash-latest. Gemini Pro cần billing + prepay.
GEMINI_MODEL=gemini-flash-lite-latest

# OpenRouteService (miễn phí, không cần thẻ) — đăng ký tại https://openrouteservice.org/dev/#/signup
# Dùng cho tìm địa điểm và dựng tuyến đi bộ; chỉ dùng phía server
ORS_API_KEY=

# Tài khoản admin duy nhất
ADMIN_USERNAME=admin
# Tạo bằng: node -e "console.log(require('bcryptjs').hashSync('mat-khau', 12))"
# Lưu ý: escape mọi ký tự $ thành \$ (Next diễn giải $ thành biến)
ADMIN_PASSWORD_HASH=
# Chuỗi ngẫu nhiên >= 32 ký tự để ký JWT phiên đăng nhập
SESSION_SECRET=

# Gemini (Google AI Studio)
GEMINI_API_KEY=
# Mặc định gemini-flash-latest (free tier). Gemini Pro cần billing + prepay.
GEMINI_MODEL=gemini-flash-latest

# Google Maps — key phía server: chỉ bật Places API (New) + Routes API
GOOGLE_MAPS_SERVER_KEY=
# Google Maps — key phía trình duyệt: chỉ bật Maps JavaScript API, giới hạn theo HTTP referrer
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=
# Map ID (tuỳ chọn, cần cho Advanced Markers)
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=
